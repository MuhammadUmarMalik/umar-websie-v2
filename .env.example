NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Set to "true" when connecting to Neon/external Postgres over SSL
DATABASE_SSL=false

# ── Admin CMS ─────────────────────────────────────────────────
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Random string, min 32 chars: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SECRET=

# ── Comments ──────────────────────────────────────────────────
AUTO_APPROVE_COMMENTS=false

# ── Contact form ──────────────────────────────────────────────
# Google Apps Script URL (optional) — appends submissions to a Google Sheet
GOOGLE_APPS_SCRIPT_URL=

# ── Email (Nodemailer + SMTP) ─────────────────────────────
# Free options: Gmail (app password, 500/day) or Brevo (300/day free tier)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where form / comment notifications are sent
CONTACT_EMAIL_TO=

# ── Analytics (all optional) ─────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=

# ── Chatbot ───────────────────────────────────────────────────
# Provider: "groq" (default) | "openrouter" | "ollama"
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_BASE_URL=

# ── Lead notifications (optional) ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
